# ---------------------------------------------------------------------------
# Bazel
# ---------------------------------------------------------------------------

# Convenience symlinks Bazel drops at the workspace root. They point into the
# output base under %USERPROFILE%\_bazel_%USERNAME%, so there is nothing here to
# track.
/bazel-bin
/bazel-out
/bazel-ptflio
/bazel-testlogs

# User-local Bazel overrides. .bazelrc itself IS tracked -- it carries the
# /std:c++17 flags the build needs.
/.bazelrc.user
/user.bazelrc

# NOTE: MODULE.bazel.lock is deliberately NOT ignored. It pins the resolved
# versions of rules_cc and platforms, so committing it keeps builds reproducible.

# ---------------------------------------------------------------------------
# vcpkg
# ---------------------------------------------------------------------------

# Regenerated by `vcpkg install` from third/vcpkg.json. ~90 MB of build output,
# and third/vcpkg-configuration.json pins the registry baseline, so the tree is
# reproducible without committing it. See README.md.
/third/vcpkg_installed/

# ---------------------------------------------------------------------------
# ONNX Runtime (DirectML build)
# ---------------------------------------------------------------------------

# Vendored from the Microsoft.ML.OnnxRuntime.DirectML NuGet package by
# `python third/fetch_onnxruntime.py`. 18 MB, almost all of it onnxruntime.dll,
# and the script pins the exact version -- so it is reproducible without
# committing a binary into history. See README.md.
/third/onnxruntime/

# ---------------------------------------------------------------------------
# FloodDiffusion ONNX models
# ---------------------------------------------------------------------------

# Staged from a FloodDiffusion export by
# `python tools/prepare_flooddiffusion.py <onnx_models/tiny>`. 1.2 GB, almost
# all of it text_encoder.onnx, and the weights are not ours to redistribute.
# The script regenerates the whole tree, tokenizer.bin and pipeline.txt
# included. See README.md.
/resources/FloodDiffusion/

# ---------------------------------------------------------------------------
# Large staged scenes
# ---------------------------------------------------------------------------

# Amazon Lumberyard Bistro. The copy actually used lives in a SIBLING checkout
# (../niagara_bistro) and so is not covered by this file at all; this entry is
# for a hand-staged export dropped inside the repo instead. One directory per
# variant; the first .gltf or .glb in each is what gets loaded. See README.md.
/resources/bistro/

# Generated by `python tools/make_alpha_fixture.py`: six quads that pin down
# alpha coverage and face culling. Derivable, so not tracked.
/resources/alpha-test/

# Generated by `python tools/make_brdf_fixture.py`: four quads and one point
# light whose shaded values are closed-form, for checking PSLighting against
# the Khronos glTF Sample Renderer's formulas.
/resources/brdf-test/

# Generated by `python tools/make_specgloss_fixture.py`: factor-only
# specular-glossiness materials whose converted metallic, roughness and base
# colour are closed-form.
/resources/specgloss-test/

# ---------------------------------------------------------------------------
# Generated / runtime files
# ---------------------------------------------------------------------------

# Written by Dear ImGui at shutdown to remember window layout. Per-developer.
imgui.ini

# Generated for clangd / IDE indexing from the Bazel graph.
/compile_commands.json
/.cache/

# Source archives of assets that are committed in extracted form. The extracted
# directory is what the code loads; the .zip is just the download.
# Blender's UV-only export: geometry and hierarchy with a second UV set, which
# the renderer harvests TEXCOORD_1 from. Generated by tools/blender_unwrap.py
# and reproducible from the asset, so it is not committed.
/resources/lightmap-uv/
/resources/*.zip

# ---------------------------------------------------------------------------
# Editors and tooling
# ---------------------------------------------------------------------------

# .vscode/launch.json and settings.json are tracked on purpose -- they are the
# shared debug configuration. Only VS Code's generated caches are ignored.
/.vscode/ipch/
/.vscode/browse.vc.db*
/.vscode/*.log

# Visual Studio
/.vs/
*.user
*.suo

# ---------------------------------------------------------------------------
# Build detritus
# ---------------------------------------------------------------------------

# Bazel keeps every artifact in the output base, so these only appear if a
# compiler or dxc is invoked by hand at the workspace root.
*.obj
*.pdb
*.ilk
*.exp
*.idb

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------

Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# Shader analysis files
*.wpix

# Python codes
*.pyc