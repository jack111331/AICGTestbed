# ---------------------------------------------------------------------------
# Bazel
# ---------------------------------------------------------------------------

# Convenience symlinks Bazel drops at the workspace root. They point into the
# output base under %USERPROFILE%\_bazel_%USERNAME%, so there is nothing here to
# track.
/bazel-bin
/bazel-out
/bazel-ptflio
/bazel-testlogs

# User-local Bazel overrides. .bazelrc itself IS tracked -- it carries the
# /std:c++17 flags the build needs.
/.bazelrc.user
/user.bazelrc

# NOTE: MODULE.bazel.lock is deliberately NOT ignored. It pins the resolved
# versions of rules_cc and platforms, so committing it keeps builds reproducible.

# ---------------------------------------------------------------------------
# vcpkg
# ---------------------------------------------------------------------------

# Regenerated by `vcpkg install` from third/vcpkg.json. ~90 MB of build output,
# and third/vcpkg-configuration.json pins the registry baseline, so the tree is
# reproducible without committing it. See README.md.
/third/vcpkg_installed/

# ---------------------------------------------------------------------------
# Generated / runtime files
# ---------------------------------------------------------------------------

# Written by Dear ImGui at shutdown to remember window layout. Per-developer.
imgui.ini

# Generated for clangd / IDE indexing from the Bazel graph.
/compile_commands.json
/.cache/

# Source archives of assets that are committed in extracted form. The extracted
# directory is what the code loads; the .zip is just the download.
/resources/*.zip

# ---------------------------------------------------------------------------
# Editors and tooling
# ---------------------------------------------------------------------------

# .vscode/launch.json and settings.json are tracked on purpose -- they are the
# shared debug configuration. Only VS Code's generated caches are ignored.
/.vscode/ipch/
/.vscode/browse.vc.db*
/.vscode/*.log

# Visual Studio
/.vs/
*.user
*.suo

# ---------------------------------------------------------------------------
# Build detritus
# ---------------------------------------------------------------------------

# Bazel keeps every artifact in the output base, so these only appear if a
# compiler or dxc is invoked by hand at the workspace root.
*.obj
*.pdb
*.ilk
*.exp
*.idb

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------

Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
