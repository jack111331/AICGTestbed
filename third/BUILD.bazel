# third/ holds the dependency wiring: the vcpkg manifest, the build files handed
# to new_local_repository in MODULE.bazel (vcpkg.BUILD, fastgltf.BUILD), and the
# targets below for dependencies that need no external repo at all.

load("@rules_cc//cc:defs.bzl", "cc_import", "cc_library")

# DirectML needs no download and no vcpkg port -- vcpkg has none. Everything
# comes from what is already on the toolchain's search paths:
#
#   DirectML.h       Windows SDK  Include/<ver>/um
#   directml.lib     Windows SDK  Lib/<ver>/um/x64
#   directml.dll     in-box       %WINDIR%\System32 (Windows 10 1903+)
#
# So this is a header-free, source-free target: just the link flag and the
# version define. Nothing to stage into runfiles, since the DLL ships with the OS.
cc_library(
    name = "directml",
    # DirectML.h derives DML_TARGET_VERSION from NTDDI_VERSION via a ladder, so
    # leaving it implicit pins the API surface to whatever NTDDI the SDK settles
    # on rather than to what the runtime can do. Measured on this machine
    # (SDK 10.0.26100, Engine/pch.h setting _WIN32_WINNT 0x0A00 before
    # SDKDDKVer.h): NTDDI_VERSION comes out 0x0A000010 (NTDDI_WIN10_NI) and
    # DML_TARGET_VERSION 0x5000 -- feature level 5.0, hiding everything added in
    # DirectML 6.x. USE_LATEST opts into 0x6400 instead.
    #
    # The trade-off: the compile-time surface is now newer than some machines'
    # in-box runtime, so anything above the level you are willing to require must
    # be gated on IDMLDevice::CheckFeatureSupport(DML_FEATURE_FEATURE_LEVELS,
    # ...) at run time. See Engine/directml-smoke.cc for how to query it.
    defines = ["DML_TARGET_VERSION_USE_LATEST"],
    linkopts = [
        "-DEFAULTLIB:directml.lib",
        # DMLCreateDevice takes an ID3D12Device, so callers always need D3D12 too.
        "-DEFAULTLIB:d3d12.lib",
        "-DEFAULTLIB:dxgi.lib",
        "-DEFAULTLIB:dxguid.lib",
    ],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# ONNX Runtime with the DirectML execution provider.
#
# Vendored from the Microsoft.ML.OnnxRuntime.DirectML 1.24.4 NuGet package
# (third/onnxruntime/), because the vcpkg onnxruntime port CANNOT build this EP:
# its portfile maps `directml -> onnxruntime_USE_DML` but no `directml` feature
# is declared in its vcpkg.json, so the mapping can never activate. The only
# alternatives were this redist or a from-source build with --use_dml.
#
# Why this rather than only translating ONNX by hand (see Engine/OnnxModel.cc):
# the DML EP takes OUR IDMLDevice and OUR ID3D12CommandQueue via
# OrtDmlApi::SessionOptionsAppendExecutionProvider_DML1, and binds OUR
# ID3D12Resource into an Ort::Value through CreateGPUAllocationFromD3DResource
# with no copy. Because its work is submitted to the same queue, it is ordered
# against the renderer's submissions without any fence, and Run() does not stall
# the CPU. It records onto its own command lists rather than one we pass in,
# which is the only behavioural difference from the hand-translated path.
#
# DirectML.dll is NOT in this package: onnxruntime.dll imports it and resolves
# against the in-box %WINDIR%\System32\DirectML.dll. The package declares a
# dependency on Microsoft.AI.DirectML 1.15.4 and the in-box copy on this machine
# is 1.15.5, so it satisfies it. A machine with an older in-box DirectML would
# need that redist as well -- check with
# `(Get-Item C:\Windows\System32\DirectML.dll).VersionInfo.FileVersion`.
#
# NOTE this is a RELEASE-only binary, built with /MD, and it is used in -c dbg
# too where Bazel compiles with /MDd. That is safe here, unlike the vcpkg
# packages which ship both variants: onnxruntime exposes a flat C ABI and the
# C++ header is only inline wrappers over it, so no CRT-owned object ever
# crosses the DLL boundary.
# ---------------------------------------------------------------------------

cc_import(
    name = "onnxruntime_prebuilt",
    interface_library = "onnxruntime/lib/onnxruntime.lib",
    shared_library = "onnxruntime/bin/onnxruntime.dll",
)

cc_library(
    name = "onnxruntime",
    hdrs = glob(["onnxruntime/include/*.h"]),
    # dml_provider_factory.h needs the D3D12 and DirectML declarations, which
    # come from the Windows SDK via //third:directml.
    includes = ["onnxruntime/include"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = [
        ":directml",
        ":onnxruntime_prebuilt",
    ],
)

# onnxruntime_providers_shared.dll is loaded by name at run time when an EP
# lives in its own module. The DirectML EP is built into onnxruntime.dll, so
# nothing links against this -- it is staged only so a future EP that does need
# it finds it beside the executable.
filegroup(
    name = "onnxruntime_runtime_files",
    srcs = ["onnxruntime/bin/onnxruntime_providers_shared.dll"],
    visibility = ["//visibility:public"],
)

# stb_image, as a normal compiled library. The headers come from the vcpkg port;
# what this adds is the single translation unit that instantiates them.
cc_library(
    name = "stb",
    srcs = ["stb_impl.cc"],
    # STB_IMAGE_IMPLEMENTATION must reach exactly ONE translation unit in the
    # binary -- local_defines keeps it off every dependent, which `defines` would
    # not, and a second definition is a duplicate-symbol link error.
    local_defines = ["STB_IMAGE_IMPLEMENTATION"],
    # This one is deliberately propagated: it changes how stbi_load interprets
    # filenames (UTF-8 rather than the ANSI codepage, converted to wide internally
    # on Windows) and it also guards the declaration of
    # stbi_convert_wchar_to_utf8, so dependents must see the same value.
    defines = ["STBI_WINDOWS_UTF8"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = ["@vcpkg_directxtk12//:stb_headers"],
)
